# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
ENV/

# Node (for any tooling layered on top)
node_modules/
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Build artifacts that DO NOT belong in version control
# (Phase 1+ may generate these; tracked separately by run manifests).
# Use per-file patterns rather than `data/raw/` so we can negate
# specific reference-data files (git's negation rules don't reach
# inside an excluded directory).
data/raw/*.jsonl
data/raw/*.json
data/raw/_workdir*/
data/raw/*.pdf
data/runs/*/raw/
data/evidence/*.pdf
# EXCEPTION: parcel_master.jsonl is reference data (NYS Tax Parcels
# Public, full Greene county roll, ~38 k records / 36 MB). It is the
# enrichment-only source feeding the PRINT_KEY join in the staged
# pipeline; without it the dashboard publishes every lead as
# "Unknown — UNKNOWN — No property address" (see commit log entry
# for the 2026-05-25 regression). It updates annually with the
# assessment roll, not daily, so we commit it rather than re-pulling
# each cron tick. Refresh via the workflow_dispatch input
# `refresh_parcel_master=true` when a new roll year ships.
!data/raw/parcel_master.jsonl

# Per-county run logs and transient artifacts
# The runs/<slug>/ folder itself IS committed (launch files, manifests, notes).
# But per-county logs are scratch and not committed.
runs/*/logs/
runs/*/tmp/
runs/*/.cache/

# Secrets — never commit
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# Coverage / test artifacts
.coverage
htmlcov/
.tox/

# Stealth-recon snapshots: HTML/PNG are bulky; the .json/.md summaries
# committed under runs/greene_ny/recon/stealth_probe/ + stealth_recon_*.md
# capture the actionable findings. Regenerable from the probe_*.py scripts.
runs/greene_ny/recon/stealth_probe/*.html
runs/greene_ny/recon/stealth_probe/*.png

# Missed-source audit raw artifacts: HTML snapshots, raw OCR/XML evidence,
# Wayback-fetched PDFs. The .json + MISSED_SOURCE_AUDIT.md summaries are
# the durable record; regenerable from the audit scripts saved alongside.
runs/greene_ny/recon/audit_2026-05-25/*.html
runs/greene_ny/recon/audit_2026-05-25/*.png
runs/greene_ny/recon/audit_2026-05-25/*.xml
runs/greene_ny/recon/audit_2026-05-25/*.txt
runs/greene_ny/recon/audit_2026-05-25/*.pdf
runs/greene_ny/recon/audit_2026-05-25/cookies.txt
